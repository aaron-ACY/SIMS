<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SIMS_BackEnd</RootNamespace>
    <UserSecretsId>2d3f5e1a-8b4c-4d9e-a0f2-7c3b1e6d5f4a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.19" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIMS.Application\SIMS.Application.csproj" />
    <ProjectReference Include="..\SIMS.Infrastructure\SIMS.Infrastructure.csproj" />
    <ProjectReference Include="..\SIMS.Shared\SIMS.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy CSV seed files to output directory so they are accessible at runtime -->
    <Content Include="Data\**\*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
